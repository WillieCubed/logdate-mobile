      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "journal",
          "entry",
          "createdAt"
        ],
        "properties": {
          "journal": {
            "type": "ref",
            "ref": "app.logdate.defs#recordRef"
          },
          "entry": {
            "type": "ref",
            "ref": "app.logdate.defs#recordRef"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
