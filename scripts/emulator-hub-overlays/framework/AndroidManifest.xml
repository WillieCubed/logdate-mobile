<?xml version="1.0" encoding="utf-8"?>
<!--
    Emulator-only overlay that turns on Android's hub (widgets over the lock screen) in the framework.
    It targets SDK 28 and is installed in /vendor/overlay, the one combination Android lets overlay
    framework settings that are not marked overlayable. scripts/hub-widget-screenshots.sh builds it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="studio.hypertext.logdate.emulator.hubframework">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28" />
    <overlay android:targetPackage="android" android:isStatic="true" android:priority="10" />
    <application android:hasCode="false" />
</manifest>
