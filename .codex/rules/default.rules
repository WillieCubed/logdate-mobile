# Scoped adb diagnostics are validated by block_unsafe_android_commands.py.
# Physical-device access still requires an explicit user override in AGENTS.md.
prefix_rule(
    pattern = ["adb", ["shell", "install", "uninstall", "push", "pull", "reboot", "root", "logcat", "-d", "-e"]],
    decision = "forbidden",
    justification = "Use an explicit adb -s target for approved read-only diagnostics; device mutations remain blocked by the Android hook.",
    match = [
        "adb shell pm clear studio.hypertext.logdate",
        "adb install app.apk",
        "adb -d logcat -d",
    ],
    not_match = [
        "adb devices -l",
        "adb -s approved-phone shell dumpsys package studio.hypertext.logdate",
    ],
)

prefix_rule(
    pattern = ["fastboot"],
    decision = "forbidden",
    justification = "Do not use fastboot for LogDate from Codex.",
    match = [
        "fastboot devices",
    ],
)

prefix_rule(
    pattern = ["./gradlew", "connectedAndroidTest"],
    decision = "forbidden",
    justification = "Connected Android test tasks are blocked for LogDate. Use a Gradle Managed Device task instead.",
    match = [
        "./gradlew connectedAndroidTest",
    ],
)

prefix_rule(
    pattern = ["./gradlew", "connectedDebugAndroidTest"],
    decision = "forbidden",
    justification = "Connected Android test tasks are blocked for LogDate. Use a Gradle Managed Device task instead.",
    match = [
        "./gradlew connectedDebugAndroidTest",
    ],
)

prefix_rule(
    pattern = ["./gradlew", ":app:android-main:connectedDebugAndroidTest"],
    decision = "forbidden",
    justification = "Do not run :app:android-main:connectedDebugAndroidTest in LogDate because it may accidentally delete data from the user's physical device. Use a Gradle Managed Device or emulator-only task instead.",
    match = [
        "./gradlew :app:android-main:connectedDebugAndroidTest",
    ],
)

prefix_rule(
    pattern = ["gradlew", "connectedAndroidTest"],
    decision = "forbidden",
    justification = "Connected Android test tasks are blocked for LogDate. Use a Gradle Managed Device task instead.",
    match = [
        "gradlew connectedAndroidTest",
    ],
)

prefix_rule(
    pattern = ["gradlew", "connectedDebugAndroidTest"],
    decision = "forbidden",
    justification = "Connected Android test tasks are blocked for LogDate. Use a Gradle Managed Device task instead.",
    match = [
        "gradlew connectedDebugAndroidTest",
    ],
)

prefix_rule(
    pattern = ["gradlew", ":app:android-main:connectedDebugAndroidTest"],
    decision = "forbidden",
    justification = "Do not run :app:android-main:connectedDebugAndroidTest in LogDate because it may accidentally delete data from the user's physical device. Use a Gradle Managed Device or emulator-only task instead.",
    match = [
        "gradlew :app:android-main:connectedDebugAndroidTest",
    ],
)

prefix_rule(
    pattern = ["gradle", "connectedAndroidTest"],
    decision = "forbidden",
    justification = "Connected Android test tasks are blocked for LogDate. Use a Gradle Managed Device task instead.",
    match = [
        "gradle connectedAndroidTest",
    ],
)

prefix_rule(
    pattern = ["gradle", ":app:android-main:connectedDebugAndroidTest"],
    decision = "forbidden",
    justification = "Do not run :app:android-main:connectedDebugAndroidTest in LogDate because it may accidentally delete data from the user's physical device. Use a Gradle Managed Device or emulator-only task instead.",
    match = [
        "gradle :app:android-main:connectedDebugAndroidTest",
    ],
)
