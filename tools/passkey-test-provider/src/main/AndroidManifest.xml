<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The ceremony derives its `android:apk-key-hash:` origin from the *calling* app's signing
      certificate, which means reading that package's signing info. Package visibility on API 30+
      hides every other app by default, so without this the lookup throws NameNotFoundException and
      the ceremony fails before it starts.

      The id comes from the same logdate.applicationId property the app itself is built with, so a
      build made with a custom id stays visible without widening this to QUERY_ALL_PACKAGES, which
      is both broader than needed and a lint error.
    -->
    <queries>
        <package android:name="${appUnderTestId}" />
    </queries>


    <application
        android:label="LogDate Test Authenticator"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar">

        <!--
          Registers this app with Credential Manager. BIND_CREDENTIAL_PROVIDER_SERVICE ensures only
          the system can bind, and the meta-data declares which credential types are handled.
        -->
        <service
            android:name=".TestPasskeyProviderService"
            android:enabled="true"
            android:exported="true"
            android:label="LogDate Test Authenticator"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/provider" />
        </service>

        <activity
            android:name=".CeremonyActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />
    </application>
</manifest>
