project_id      = "logdate-production"
region          = "us-central1"
service_name    = "logdate-server"
cloud_run_image = "us-central1-docker.pkg.dev/logdate-production/logdate/logdate-server:latest"
webauthn_rp_id  = "cloud.logdate.app"
webauthn_origin = "https://cloud.logdate.app"

enable_github_oidc = true
github_repo        = "your-org/logdate"

enable_domain_mapping = true
domains               = ["cloud.logdate.app", "logdate.hypertext.studio"]

create_gcs_bucket = true
gcs_bucket_name   = "logdate-media-production"

cloud_run_env = {
  AUTO_MIGRATE = "false"
}

cloud_run_secret_env = {
  # Replace each example version with an enabled numeric version in the
  # production project. Never use Secret Manager's mutable `latest` alias.
  DATABASE_URL             = { secret_id = "logdate-db-url", version = "1" }
  DATABASE_USER            = { secret_id = "logdate-db-user", version = "1" }
  DATABASE_PASSWORD        = { secret_id = "logdate-db-password", version = "1" }
  JWT_SECRET               = { secret_id = "logdate-jwt-secret", version = "1" }
  GOOGLE_OIDC_CLIENT_IDS   = { secret_id = "logdate-google-oidc-client-ids", version = "1" }
  REDIS_URL                = { secret_id = "logdate-redis-url", version = "1" }
  SERVER_ENCRYPTION_KEY    = { secret_id = "logdate-server-encryption-key", version = "1" }
  SERVER_ENCRYPTION_KEY_ID = { secret_id = "logdate-server-encryption-key-id", version = "1" }
  HEALTH_INTERNAL_TOKEN    = { secret_id = "logdate-health-internal-token", version = "1" }
}

create_secrets = true
