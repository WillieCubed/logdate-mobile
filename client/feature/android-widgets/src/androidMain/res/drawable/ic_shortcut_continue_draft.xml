<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive shortcut icon matching the static shortcuts; the monochrome layer lets themed launchers recolor it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_shortcut_background" />
    <foreground android:drawable="@drawable/ic_shortcut_glyph_continue_draft" />
    <monochrome android:drawable="@drawable/ic_shortcut_glyph_continue_draft" />
</adaptive-icon>
