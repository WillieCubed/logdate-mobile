<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application>
        <receiver
            android:name="app.logdate.client.feature.widgets.OnThisDayWidgetReceiver"
            android:process=":widget_ingress"
            android:exported="false"
            android:label="@string/widget_name_on_this_day">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/on_this_day_widget_info" />
        </receiver>

        <receiver
            android:name="app.logdate.client.feature.widgets.FixedMemoryWidgetReceiver"
            android:process=":widget_ingress"
            android:exported="false"
            android:label="@string/widget_name_fixed_memory">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fixed_memory_widget_info" />
        </receiver>

        <receiver
            android:name="app.logdate.client.feature.widgets.NewEntryWidgetReceiver"
            android:process=":widget_ingress"
            android:exported="false"
            android:label="@string/widget_name_new_entry">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/new_entry_widget_info" />
        </receiver>

        <!--
            The capture widget, offered for the home screen, the lock screen, and the hub. Declared
            disabled so it stays out of the widget picker until LOCK_SCREEN_CAPTURE_WIDGET is on.
        -->
        <receiver
            android:name="app.logdate.client.feature.widgets.CaptureWidgetReceiver"
            android:process=":widget_ingress"
            android:enabled="false"
            android:exported="false"
            android:label="@string/widget_name_capture">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/capture_widget_info" />
        </receiver>

        <service
            android:name="app.logdate.client.feature.widgets.WidgetLifecycleJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name="app.logdate.client.feature.widgets.WidgetLifecycleRestartReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name="app.logdate.client.feature.widgets.OnThisDayWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.LogDate" />

        <activity
            android:name="app.logdate.client.feature.widgets.FixedMemoryWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.LogDate" />

        <activity
            android:name="app.logdate.client.feature.widgets.NewEntryWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.LogDate" />

        <activity
            android:name="app.logdate.client.feature.widgets.WidgetAudioPlaybackActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
