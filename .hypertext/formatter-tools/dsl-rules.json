{
  "setup": [
    ["python3", "{repo}/.hypertext/formatter-tools/dsl.py", "setup-docker"],
    ["python3", "{repo}/.hypertext/formatter-tools/dsl.py", "setup-awk"]
  ],
  "rules": [
    {
      "name": "dockerfmt 0.5.4",
      "patterns": ["**/Dockerfile", "Dockerfile"],
      "argv": [
        "python3",
        "{repo}/.hypertext/formatter-tools/dsl.py",
        "docker",
        "--path",
        "{path}"
      ]
    },
    {
      "name": "Studio ProGuard whitespace v1",
      "patterns": ["**/*.pro", "*.pro"],
      "argv": [
        "python3",
        "{repo}/.hypertext/formatter-tools/dsl.py",
        "proguard",
        "--path",
        "{path}"
      ]
    },
    {
      "name": "GNU Awk 5.4.1 pretty-print",
      "patterns": ["**/*.awk", "*.awk"],
      "argv": [
        "python3",
        "{repo}/.hypertext/formatter-tools/dsl.py",
        "awk",
        "--path",
        "{path}"
      ]
    }
  ]
}
