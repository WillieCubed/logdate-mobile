{
  "setup": [
    [
      "python3",
      "{root}/.hypertext/formatter-tools/document-formats.py",
      "setup-pbxproj"
    ]
  ],
  "rules": [
    {
      "name": "pbxproj",
      "patterns": ["**/*.pbxproj", "*.pbxproj"],
      "argv": [
        "python3",
        "{root}/.hypertext/formatter-tools/document-formats.py",
        "pbxproj"
      ]
    },
    {
      "name": "xcconfig",
      "patterns": ["**/*.xcconfig", "*.xcconfig"],
      "argv": [
        "python3",
        "{root}/.hypertext/formatter-tools/document-formats.py",
        "xcconfig"
      ]
    }
  ]
}
