{
  "setup": [
    [
      "python3",
      "{repo}/.hypertext/formatter-tools/native-addons.py",
      "setup-swift"
    ],
    [
      "python3",
      "{repo}/.hypertext/formatter-tools/native-addons.py",
      "setup-terraform"
    ],
    ["python3", "{repo}/.hypertext/formatter-tools/native-addons.py", "setup-c"]
  ],
  "rules": [
    {
      "name": "SwiftFormat 0.64.0",
      "patterns": ["**/*.swift", "*.swift"],
      "argv": [
        "python3",
        "{repo}/.hypertext/formatter-tools/native-addons.py",
        "swift",
        "--path",
        "{path}"
      ]
    },
    {
      "name": "Terraform 1.15.5",
      "patterns": [
        "**/*.tf",
        "*.tf",
        "**/*.tfvars",
        "*.tfvars",
        "**/*.hcl",
        "*.hcl"
      ],
      "argv": [
        "python3",
        "{repo}/.hypertext/formatter-tools/native-addons.py",
        "terraform",
        "--path",
        "{path}"
      ]
    },
    {
      "name": "clang-format 23.1.3 C",
      "patterns": ["**/*.c", "*.c", "**/*.h", "*.h"],
      "argv": [
        "python3",
        "{repo}/.hypertext/formatter-tools/native-addons.py",
        "c",
        "--path",
        "{path}"
      ]
    }
  ]
}
