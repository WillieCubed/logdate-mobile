<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Permissions required for audio recording on Wear OS -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        A mark's heart rate, read once when someone marks a moment. Wear OS 6 reads it under its own
        health permission, earlier versions under body sensors.
    -->
    <uses-permission
        android:name="android.permission.BODY_SENSORS"
        android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <!-- Places are captured on demand. Workouts use activity recognition only when reminders are enabled. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Remove OpenGL ES requirement merged from Google Maps SDK -->
    <uses-feature android:glEsVersion="0x00020000" tools:node="remove" />

    <!--
        Remove the Google Maps package query merged from client:location. Play on looks up the
        system output switcher and, on watches without it, Bluetooth settings.
    -->
    <queries>
        <package android:name="com.google.android.apps.maps" tools:node="remove" />
        <intent>
            <action android:name="com.android.settings.panel.action.MEDIA_OUTPUT" />
        </intent>
        <intent>
            <action android:name="android.settings.BLUETOOTH_SETTINGS" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault"
        android:name=".LogDateWearApplication">

        <!--
            Remove auto-initializers merged from transitive dependencies.
            Google Maps and Emoji2 are not used on Wear OS
            but their ContentProviders run before Application.onCreate(), adding
            500-1500ms of startup latency on constrained Wear hardware.
        -->

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <!-- Remove Emoji2 font download -->
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- MediaSessionService must be exported for system media controllers. -->
        <service
            android:name="app.logdate.client.media.audio.AudioPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
            Data Layer listener: receives notes, journals, associations, remote camera updates and the
            phone's state document and link requests. Play services delivers only events whose
            path is listed here.
        -->
        <service
            android:name=".sync.WearDataLayerListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:pathPrefix="/logdate/notes" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:pathPrefix="/logdate/journals" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:pathPrefix="/logdate/associations" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:pathPrefix="/logdate/camera" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:path="/logdate/state" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:pathPrefix="/logdate/v2/p2w/window/" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:pathPrefix="/logdate/v2/p2w/tombstone/" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:pathPrefix="/logdate/notes" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:pathPrefix="/logdate/sync" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:path="/logdate/v2/receipts/push" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:path="/logdate_phone_app" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:path="/logdate_phone_sync_v2" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/logdate/link" />
                <data android:path="/logdate/presence" />
                <data android:path="/logdate/reminders/claim" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.NODE_MIGRATED" />
                <data
                    android:scheme="wear"
                    android:host="*" />
            </intent-filter>
        </service>

        <!-- The shared phone receiver must not start background location on the watch. -->
        <receiver
            android:name="app.logdate.client.location.tracking.LocationTrackingBootReceiver"
            tools:node="remove" />

        <service
            android:name=".reminders.WorkoutEndListenerService"
            android:exported="true"
            android:permission="com.google.android.wearable.healthservices.permission.PASSIVE_DATA_BINDING" />
        <receiver
            android:name=".reminders.ReminderRestoreReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Entry Count complication: shows today's journal entry count -->
        <service
            android:name=".complication.EntryCountComplicationService"
            android:exported="true"
            android:label="@string/wear_complication_entry_count_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>

            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="900" />
        </service>

        <!-- Mood complication: shows today's mood emoji -->
        <service
            android:name=".complication.MoodComplicationService"
            android:exported="true"
            android:label="@string/wear_complication_mood_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>

            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="900" />
        </service>

        <!-- Streak complication: the campfire (also as a ranged value), or the journaling streak -->
        <service
            android:name=".complication.StreakComplicationService"
            android:exported="true"
            android:label="@string/wear_complication_streak_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>

            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT,RANGED_VALUE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="21600" />
        </service>

        <!-- Quick Capture complication: mic icon to start voice recording -->
        <service
            android:name=".complication.QuickCaptureComplicationService"
            android:exported="true"
            android:label="@string/wear_complication_quick_capture_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>

            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SMALL_IMAGE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!-- Quick Capture tile: four capture buttons + entry count -->
        <service
            android:name=".tile.QuickCaptureTileService"
            android:exported="true"
            android:label="@string/wear_tile_quick_capture_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>

            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <!-- Today's Summary tile: entry count, mood, latest entry -->
        <service
            android:name=".tile.TodaySummaryTileService"
            android:exported="true"
            android:label="@string/wear_tile_summary_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>

            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <!-- On this day tile: only while the new watch app is on (SurfaceComponents enables it) -->
        <service
            android:name=".tile.OnThisDayTileService"
            android:enabled="false"
            android:exported="true"
            android:label="@string/wear_memory_on_this_day"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>

            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <!-- On this day complication: only while the new watch app is on (SurfaceComponents enables it) -->
        <service
            android:name=".complication.OnThisDayComplicationService"
            android:enabled="false"
            android:exported="true"
            android:label="@string/wear_memory_on_this_day"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>

            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="3600" />
        </service>

        <!-- Mark complication: marks the moment without opening the app; only while the new watch app is on -->
        <service
            android:name=".complication.MarkComplicationService"
            android:enabled="false"
            android:exported="true"
            android:label="@string/wear_surface_mark"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>

            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,MONOCHROMATIC_IMAGE,SMALL_IMAGE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!--
               Set to true if your app is Standalone, that is, it does not require the handheld
               app to run.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Marks the moment from a complication, a tile or a notification action, without opening the app. -->
        <receiver
            android:name=".v2.mark.MarkMomentReceiver"
            android:exported="false" />

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/MainActivityTheme.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                "Open LogDate on watch" on the phone sends this link through
                RemoteActivityHelper, which only delivers browsable VIEW intents.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="studio.hypertext.logdate"
                    android:host="watch"
                    android:path="/today" />
            </intent-filter>
        </activity>
    </application>

</manifest>
