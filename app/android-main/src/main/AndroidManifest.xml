<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="internalOnly"
    android:targetSandboxVersion="2">

    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />

    <!--
        Chromebooks and desktops without a touchscreen can install LogDate; it works with a
        keyboard, mouse, or trackpad. See large-screens-and-desktop-windowing.md.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_PROFILE_WATCH" />
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />

    <application
        android:name="app.logdate.client.LogdateApplication"
        android:allowBackup="true"
        android:backupAgent="app.logdate.client.data.restore.NativeAccountBackupAgent"
        android:fullBackupOnly="true"
        android:appCategory="productivity"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LogDate"
        tools:targetApi="34">

        <meta-data
            android:name="app.logdate.watchExperienceDefault"
            android:value="${watchExperienceDefault}" />

        <!-- Maps SDK 20 can load a legacy renderer on older Google Play services. -->
        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />

        <!-- Koin installs the worker factory after loading the application's dependencies. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <meta-data
            android:name="firebase_performance_logcat_enabled"
            android:value="true" />
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_api_key" />
        <meta-data
            android:name="health_connect.privacy_policy_url"
            android:value="https://logdate.app/privacy" />

        <activity
            android:name="app.logdate.client.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LogDate.Starting"
            android:enableOnBackInvokedCallback="true"
            android:documentLaunchMode="intoExisting"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <meta-data
                android:name="android.allow.multiple_resumed_activities"
                android:value="true" />

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />

                <!--
                    Apex (logdate.app) carries legacy share URLs and the
                    marketing site; web 308s legacy share paths to the
                    canonical subdomain so iOS/Android can still claim them
                    here. Wildcard `*.logdate.app` claims the per-handle
                    portals (`<handle>.logdate.app/journal/<id>` etc.).
                    The web's AASA + assetlinks contracts mirror this
                    coverage; see logdate-web/docs/deep-linking.md.
                -->
                <data android:host="logdate.app" />
                <data android:host="*.logdate.app" />
                <data android:pathPrefix="/journal" />
                <data android:pathPrefix="/note" />
                <data android:pathPrefix="/rewind" />
                <data android:pathPrefix="/j" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="logdate" />

                <data android:host="journal" />
                <data android:host="rewind" />
                <data android:host="postcard" />
                <data android:host="day" />
                <data android:host="note" />
                <data android:host="event" />
                <data android:host="location" />
                <data android:host="search" />
                <data android:host="capture" />
                <data android:host="handoff" />
            </intent-filter>

            <!--
                Reverse-DNS in-app scheme — the modern recommendation over
                generic `logdate://`, which any other app on the device
                can register and hijack. The legacy `logdate://` filter
                above stays during the transition window so older builds
                of LogDate Web (and any cached scheme links in user
                clipboards) keep working.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="studio.hypertext.logdate" />

                <data android:host="journal" />
                <data android:host="rewind" />
                <data android:host="postcard" />
                <data android:host="day" />
                <data android:host="note" />
                <data android:host="event" />
                <data android:host="location" />
                <data android:host="search" />
                <data android:host="capture" />
                <data android:host="handoff" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Starts a new entry from launcher shortcuts, Quick Settings tiles, notifications,
                assistants, and other apps. Extras: mode (text|voice|camera|video), journal_id.
                See docs/reference/android/os-integration/capture-launch-contract.md.
            -->
            <intent-filter>
                <action android:name="app.logdate.action.CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>
        
        <!-- fullUser permits every orientation and respects the person's rotation lock. -->
        <activity
            android:name="app.logdate.client.remote.RemoteCameraActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:screenOrientation="fullUser"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name="app.logdate.client.EditorActivity"
            android:supportsPictureInPicture="true"
            android:exported="true"
            android:theme="@style/Theme.LogDate"
            android:enableOnBackInvokedCallback="true"
            android:documentLaunchMode="always"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboard|keyboardHidden|navigation"
            android:taskAffinity=".editor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
            <!-- Launchers and the taskbar offer "New window" for the editor. -->
            <property
                android:name="android.window.PROPERTY_SUPPORTS_MULTI_INSTANCE_SYSTEM_UI"
                android:value="true" />
            <!-- Keeps a floating or freeform editor window large enough to write in. -->
            <layout
                android:minWidth="280dp"
                android:minHeight="320dp" />
        </activity>

        <!--
            Android 13 and earlier: Health Connect permission dialog sends this intent when the
            user taps the privacy policy / rationale link. No permission guard — HC dialog sends
            it without holding any special permission.
        -->
        <activity-alias
            android:name=".HealthConnectPermissionsRationaleActivity"
            android:exported="true"
            android:targetActivity="app.logdate.client.MainActivity">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>

        <!--
            Android 14+: The Android system / Health Connect settings sends VIEW_PERMISSION_USAGE
            with the HEALTH_PERMISSIONS category to open the in-app permissions management screen.
            This alias is what causes LogDate to appear in Health Connect's "App permissions" list
            on Android 14+ where Health Connect is OS-integrated. Without it the app is invisible
            in HC settings regardless of other manifest entries.
        -->
        <activity-alias
            android:name=".ViewHealthPermissionUsageActivity"
            android:exported="true"
            android:targetActivity="app.logdate.client.MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name="app.logdate.client.activity.PhoneActivityTransitionReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name="app.logdate.client.ambient.AmbientPromptAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name="app.logdate.client.ambient.AmbientPromptBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Data Layer sync listener: receives notes, journals, associations, health data, the watch state document, and messages from paired Wear OS watch -->
        <service
            android:name="app.logdate.client.sync.PhoneDataLayerListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/logdate/v2/w2p/record" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:pathPrefix="/logdate/notes" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:pathPrefix="/logdate/journals" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:pathPrefix="/logdate/associations" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:pathPrefix="/logdate/health" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:path="/logdate/state" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:pathPrefix="/logdate/sync" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:pathPrefix="/logdate/notes" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:pathPrefix="/logdate/camera" />
                <data android:scheme="wear" android:host="*" android:path="/logdate/live/recording" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/logdate/v2/w2p/media" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/logdate/v2/p2w/media/" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/logdate/v2/p2w/window-body/" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:pathPrefix="/logdate/notes" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:path="/logdate_watch_sync_v2" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:path="/logdate/v2/receipts" />
                <data android:scheme="wear" android:host="*" android:path="/logdate/v2/window/resync" />
                <data android:scheme="wear" android:host="*" android:path="/logdate/v2/media/info" />
                <data android:scheme="wear" android:host="*" android:path="/logdate/v2/media/range" />
                <data android:scheme="wear" android:host="*" android:path="/logdate/v2/window/body" />
                <data android:scheme="wear" android:host="*" android:path="/logdate/reminders/claim" />
                <data android:scheme="wear" android:host="*" android:path="/logdate/live/playback/command" />
            </intent-filter>
        </service>

        <!--
            Owning the account type is what allows addAccountExplicitly to succeed. LogDate signs
            in with passkeys inside the app, so this authenticator exposes no system credential
            flow; it exists so the account can be recorded with the platform at all.
        -->
        <service
            android:name="app.logdate.client.LogDateAccountAuthenticatorService"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>

            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>

        <!--
            Quick Settings tiles. Declared disabled so they stay out of the tile picker until the
            QUICK_SETTINGS_TILES flag is on; PlatformComponentToggler enables them.
            See docs/reference/android/os-integration/quick-settings-tiles.md.
        -->
        <service
            android:name="app.logdate.client.tiles.NewEntryTileService"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_tile_new_entry"
            android:label="@string/tile_new_entry"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="app.logdate.client.tiles.RecordVoiceTileService"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_tile_record_voice"
            android:label="@string/tile_record_voice"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!--
            Floating recorder bubble. Both components are declared disabled and enabled by
            PlatformComponentToggler while the RECORDING_BUBBLE flag is on. A bubble's activity must
            be embeddable, resizable, and open a new document each time.
            See docs/reference/android/os-integration/bubbles.md.
        -->
        <activity
            android:name="app.logdate.client.bubble.RecordingBubbleActivity"
            android:allowEmbedded="true"
            android:documentLaunchMode="always"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/recorder_bubble_title"
            android:resizeableActivity="true"
            android:theme="@style/Theme.LogDate" />

        <!--
            Assistant actions (Android 16+). The AppFunctions compiler generates this service and its
            schema asset; it is declared disabled and enabled while APP_FUNCTIONS is on.
            See docs/reference/android/os-integration/app-functions.md.
            Instantiatable is ignored because release lint cannot follow the generated class, which
            lives in app/compose-main, through LogDateAppFunctions and AppFunctionService to Service.
        -->
        <service
            android:name="app.logdate.client.appfunctions.LogDateAppFunctionService"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            tools:ignore="Instantiatable"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.v2"
                android:value="logdate_app_functions.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>

        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_functions_app_metadata" />

        <!--
            Saves a capture reminder's quick reply as an entry. Reminders only offer the Write action
            while NOTIFICATION_QUICK_REPLY is on.
            See docs/reference/android/os-integration/notification-quick-reply.md.
        -->
        <receiver
            android:name="app.logdate.client.ambient.QuickReplyReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.logdate.action.QUICK_REPLY" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="app.logdate.client.bubble.FloatRecorderReceiver"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="app.logdate.action.FLOAT_RECORDER" />
            </intent-filter>
        </receiver>

        <service android:name="app.logdate.client.watch.presence.LogDateCompanionDeviceService"
            android:exported="true" android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter><action android:name="android.companion.CompanionDeviceService" /></intent-filter>
        </service>
    </application>

</manifest>
