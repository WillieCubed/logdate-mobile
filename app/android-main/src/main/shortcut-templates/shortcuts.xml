<?xml version="1.0" encoding="utf-8"?>
<!--
  Static launcher shortcuts and the Direct Share target declaration.

   1. New entry, Record voice, and Take photo: the capture shortcuts people see
      when they long-press the LogDate icon. Each sends app.logdate.action.CAPTURE
      with a mode, the shared capture launch contract that every surface uses
      (docs/reference/android/os-integration/capture-launch-contract.md).
      Shortcut ids are permanent: people pin these, and a renamed id orphans
      the pinned copy. new_note keeps its original id for that reason.

   2. <share-target> entries that tell the system which dynamic shortcut
      categories can receive which MIME types from the share sheet. The
      per-journal sharing shortcuts are published by DynamicShortcutPublisher /
      AndroidDynamicShortcutApplier with the android.shortcut.conversation
      category, so the share sheet offers them as Direct Share targets. The
      MIME types here must match the SEND intent filters on MainActivity.

   3. Stateful launcher shortcuts (continue draft, today's timeline) are
      published dynamically, not declared here.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_new_entry"
        android:shortcutDisabledMessage="@string/shortcut_label_new_note_disabled"
        android:shortcutId="new_note"
        android:shortcutLongLabel="@string/shortcut_label_new_note_long"
        android:shortcutShortLabel="@string/shortcut_label_new_note_short">
        <intent
            android:action="app.logdate.action.CAPTURE"
            android:targetClass="app.logdate.client.MainActivity"
            android:targetPackage="@APPLICATION_ID@">
            <extra
                android:name="mode"
                android:value="text" />
        </intent>
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_record_voice"
        android:shortcutDisabledMessage="@string/shortcut_label_capture_disabled"
        android:shortcutId="record_voice"
        android:shortcutLongLabel="@string/shortcut_label_record_voice_long"
        android:shortcutShortLabel="@string/shortcut_label_record_voice_short">
        <intent
            android:action="app.logdate.action.CAPTURE"
            android:targetClass="app.logdate.client.MainActivity"
            android:targetPackage="@APPLICATION_ID@">
            <extra
                android:name="mode"
                android:value="voice" />
        </intent>
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_take_photo"
        android:shortcutDisabledMessage="@string/shortcut_label_capture_disabled"
        android:shortcutId="take_photo"
        android:shortcutLongLabel="@string/shortcut_label_take_photo_long"
        android:shortcutShortLabel="@string/shortcut_label_take_photo_short">
        <intent
            android:action="app.logdate.action.CAPTURE"
            android:targetClass="app.logdate.client.MainActivity"
            android:targetPackage="@APPLICATION_ID@">
            <extra
                android:name="mode"
                android:value="camera" />
        </intent>
    </shortcut>

    <share-target android:targetClass="app.logdate.client.MainActivity">
        <data android:mimeType="text/plain" />
        <data android:mimeType="image/*" />
        <data android:mimeType="video/*" />
        <category android:name="android.shortcut.conversation" />
    </share-target>
</shortcuts>
