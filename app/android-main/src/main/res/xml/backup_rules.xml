<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for pre-API 31 devices.
   See https://developer.android.com/guide/topics/data/autobackup

   Cloud backup: DataStore preferences, the database-passphrase backup, the
   identity-recovery-phrase backup, and the encrypted database (all require
   clientSideEncryption so they're encrypted in the cloud).
   Device-to-device includes only paths in its explicit include list; temporary
   camera-capture output is omitted along with device-bound preferences,
   background jobs, and incomplete media staging.
-->
<full-backup-content>
    <include domain="sharedpref" path="logdate_widget_instances.xml" requireFlags="clientSideEncryption"/>
    <include domain="sharedpref" path="logdate_widget_instances.xml" requireFlags="deviceToDeviceTransfer"/>
    <include domain="file" path="logdate.preferences_pb"
             requireFlags="clientSideEncryption"/>
    <include domain="file" path="archive_recovery/records/" requireFlags="clientSideEncryption"/>
    <include domain="file" path="datastore/"
             requireFlags="clientSideEncryption"/>
    <include domain="file" path="db_recovery/"
             requireFlags="clientSideEncryption"/>
    <include domain="file" path="identity_recovery/"
             requireFlags="clientSideEncryption"/>
    <include domain="database" path="logdate"
             requireFlags="clientSideEncryption"/>
    <include domain="database" path="logdate-wal"
             requireFlags="clientSideEncryption"/>
    <include domain="database" path="logdate-shm"
             requireFlags="clientSideEncryption"/>
    <include domain="file" path="logdate.preferences_pb"
             requireFlags="deviceToDeviceTransfer"/>
    <include domain="file" path="archive_recovery/records/" requireFlags="deviceToDeviceTransfer"/>
    <include domain="file" path="archive_recovery/sources/" requireFlags="deviceToDeviceTransfer"/>
    <include domain="file" path="datastore/"
             requireFlags="deviceToDeviceTransfer"/>
    <include domain="file" path="db_recovery/"
             requireFlags="deviceToDeviceTransfer"/>
    <include domain="file" path="identity_recovery/"
             requireFlags="deviceToDeviceTransfer"/>
    <include domain="file" path="media/"
             requireFlags="deviceToDeviceTransfer"/>
    <include domain="file" path="user_media/"
             requireFlags="deviceToDeviceTransfer"/>
    <include domain="file" path="audio_notes/"
             requireFlags="deviceToDeviceTransfer"/>
    <include domain="database" path="logdate"
             requireFlags="deviceToDeviceTransfer"/>
    <include domain="database" path="logdate-wal"
             requireFlags="deviceToDeviceTransfer"/>
    <include domain="database" path="logdate-shm"
             requireFlags="deviceToDeviceTransfer"/>
    <exclude domain="file" path="media/staging/"/>
    <exclude domain="file" path="audio_notes/staging/"/>
    <exclude domain="file" path="db_recovery/passphrase_backup.part"/>
    <exclude domain="file" path="identity_recovery/phrase_backup.part"/>
    <exclude domain="file" path="identity_recovery/account_key_backup.part"/>
    <exclude domain="file" path="identity_recovery/media_key_backup.part"/>
</full-backup-content>
