<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup/restore rules for Android 12+ (API 31+).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   Cloud backup (Google Drive, 25 MB limit):
     Includes the encrypted database and the recoverable database-passphrase and
     identity-recovery-phrase backups so small databases and the user's identity key
     survive cloud restore. Exceeding the quota prevents a new cloud backup;
     it does not selectively omit large files. Recovery secrets require an
     encrypted cloud transport. Original media is covered by direct transfer,
     LogDate Cloud, or a user-created archive.

   Device-to-device transfer:
     Includes committed media, but omits temporary camera-capture output from
     its explicit include list. It also excludes Keystore-bound ciphertext,
     installation state, incomplete media staging, and cloned background jobs.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="sharedpref" path="logdate_widget_instances.xml"/>
        <include domain="file" path="logdate.preferences_pb"/>
        <include domain="file" path="datastore/"/>
        <include domain="file" path="archive_recovery/records/"/>
        <include domain="file" path="db_recovery/"/>
        <include domain="file" path="identity_recovery/"/>
        <include domain="database" path="logdate"/>
        <include domain="database" path="logdate-wal"/>
        <include domain="database" path="logdate-shm"/>
        <exclude domain="file" path="db_recovery/passphrase_backup.part"/>
        <exclude domain="file" path="identity_recovery/phrase_backup.part"/>
        <exclude domain="file" path="identity_recovery/account_key_backup.part"/>
        <exclude domain="file" path="identity_recovery/media_key_backup.part"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="logdate_widget_instances.xml"/>
        <include domain="file" path="logdate.preferences_pb"/>
        <include domain="file" path="datastore/"/>
        <include domain="file" path="archive_recovery/records/"/>
        <include domain="file" path="db_recovery/"/>
        <include domain="file" path="identity_recovery/"/>
        <include domain="file" path="archive_recovery/sources/"/>
        <include domain="file" path="media/"/>
        <include domain="file" path="user_media/"/>
        <include domain="file" path="audio_notes/"/>
        <include domain="database" path="logdate"/>
        <include domain="database" path="logdate-wal"/>
        <include domain="database" path="logdate-shm"/>
        <exclude domain="file" path="media/staging/"/>
        <exclude domain="file" path="audio_notes/staging/"/>
        <exclude domain="file" path="db_recovery/passphrase_backup.part"/>
        <exclude domain="file" path="identity_recovery/phrase_backup.part"/>
        <exclude domain="file" path="identity_recovery/account_key_backup.part"/>
        <exclude domain="file" path="identity_recovery/media_key_backup.part"/>
    </device-transfer>
</data-extraction-rules>
