<?xml version="1.0" encoding="utf-8"?>
<!--
    Declares LogDate as the owner of its account type. The platform matches on the literal string,
    and a mismatch fails addAccountExplicitly with a SecurityException rather than any clearer
    error, so both sides derive the type from the applicationId: the build generates
    logdate_account_type, and AndroidAccountManager appends the same suffix to its package name.
-->
<account-authenticator xmlns:android="http://schemas.android.com/apk/res/android"
    android:accountType="@string/logdate_account_type"
    android:icon="@mipmap/ic_launcher"
    android:smallIcon="@mipmap/ic_launcher"
    android:label="@string/app_name" />
