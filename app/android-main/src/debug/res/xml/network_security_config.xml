<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only. targetSdk is well past 28, so cleartext is denied by default and every
  http:// request to a LogDate server running on the developer's machine fails outright.

  Scoped to the loopback addresses an emulator uses to reach its host rather than opening
  cleartext generally: 10.0.2.2 is the host from inside a standard AVD, 127.0.0.1/localhost
  cover an adb-reversed port. Release builds never see this file.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
