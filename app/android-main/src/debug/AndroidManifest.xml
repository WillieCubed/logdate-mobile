<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name="app.logdate.client.e2e.ShareEntryPointHostActivity"
            android:exported="false"
            android:theme="@style/Theme.LogDate" />
        <activity
            android:name="app.logdate.client.e2e.VideoPlaybackHostActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.LogDate" />
        <provider
            android:name="app.logdate.client.media.MediaReclamationProbeProvider"
            android:authorities="${applicationId}.media-reclamation-probe"
            android:exported="false"
            android:process=":media_reclamation_probe" />
    </application>
</manifest>
